{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist/server",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/server/**/*",
    "src/models/**/*",
    "src/repositories/**/*",
    "src/services/**/*",
    "src/lib/**/*"
  ],
  "exclude": [
    "src/lib/auth.ts",
    "src/lib/api.ts",
    "src/app/**/*",
    "src/providers/**/*"
  ]
}
